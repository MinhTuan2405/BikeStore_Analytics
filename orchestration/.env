# Dagster instance storage settings for local host CLI usage.
# Use localhost here because `uv run dg ...` runs outside Docker.
DAGSTER_POSTGRES_HOST=localhost
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_DB=dagster

# Datasource connection (Supabase)
DATASOURCE_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DATASOURCE_PORT=5432
DATASOURCE_DATABASE=postgres
DATASOURCE_USER=postgres.ybugsgxlghxyltyhocnf
DATASOURCE_PASSWORD=iZie5iu8bkfBoKNk
DATASOURCE_SSLMODE=require

# MinIO (local dev: run against localhost:9000)
LAKEHOUSE_BUCKET=lakehouse
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
