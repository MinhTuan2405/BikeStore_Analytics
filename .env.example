MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEHOUSE_BUCKET=lakehouse
AWS_DEFAULT_REGION=us-east-1

DAGSTER_POSTGRES_HOST=backend_storage
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_PORT_ON_HOST=5432
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=dagster
DAGSTER_POSTGRES_DB=dagster


DATASOURCE_NAME=supabase
DATASOURCE_UNIT_NAME=supabase_source
DATASOURCE_HOST=<supabase-postgres-host>
DATASOURCE_PORT=5432
DATASOURCE_DATABASE=postgres
DATASOURCE_USER=<supabase-postgres-user>
DATASOURCE_PASSWORD=<supabase-postgres-password>
DATASOURCE_SSLMODE=require
DATASOURCE_TABLES=sales.orders
DATASOURCE_WATERMARK_COLUMNS=sales.orders:order_date
DATASOURCE_PRIMARY_KEYS=sales.orders:order_id
DATASOURCE_BATCH_SIZE=10000

# MinIO endpoint — use http://minio:9000 inside Docker, http://localhost:9000 for local dev
AWS_ENDPOINT_URL=http://localhost:9000
