//// Generated from dbt_bsdp/models/common_bs
//// Star schema for the common_bs dbt mart.

Project common_bs {
  database_type: 'DuckDB'
  Note: '''
    dbt common_bs mart generated from dbt_bsdp/models/common_bs.
    Models are materialized as external Parquet files under s3://LAKEHOUSE_BUCKET/common_bs/<model_name>.
  '''
}

Table dim_customer {
  dim_customer_sk varchar(32) [pk, note: 'Surrogate key. MD5 hash of customer_id.']
  customer_id integer [unique, not null, note: 'Natural key from sales.customers. -1 for the missing member row.']
  first_name varchar [not null, note: 'Trimmed first name.']
  last_name varchar [not null, note: 'Trimmed last name.']
  full_name varchar [not null, note: 'Concatenated first and last name.']
  email varchar [note: 'Lowercased email address. Null for the missing member row.']
  phone varchar [note: 'Contact phone number.']
  street varchar [note: 'Street address.']
  city varchar [note: 'City.']
  state varchar [note: 'Two-letter US state code, uppercased.']
  zip_code varchar [note: 'ZIP or postal code.']

  Note: 'Conformed customer dimension, Type 1. Includes a missing member row for guest or anonymous orders.'
}

Table dim_product {
  dim_product_sk varchar(32) [pk, note: 'Surrogate key. MD5 hash of product_id.']
  product_id integer [unique, not null, note: 'Natural key from production.products. -1 for the missing member row.']
  product_name varchar [not null, note: 'Trimmed product display name.']
  model_year smallint [note: 'Model year of the bicycle.']
  list_price decimal(10,2) [note: 'Current retail list price.']
  brand_id integer [not null, note: 'Natural key from production.brands. -1 for the missing member row.']
  brand_name varchar [not null, note: 'Brand display name.']
  category_id integer [not null, note: 'Natural key from production.categories. -1 for the missing member row.']
  category_name varchar [not null, note: 'Category display name.']

  Note: 'Conformed product dimension enriched with brand and category names, Type 1.'
}

Table dim_store {
  dim_store_sk varchar(32) [pk, note: 'Surrogate key. MD5 hash of store_id.']
  store_id integer [unique, not null, note: 'Natural key from sales.stores. -1 for the missing member row.']
  store_name varchar [not null, note: 'Store display name.']
  phone varchar [note: 'Store contact phone.']
  email varchar [note: 'Store contact email.']
  street varchar [note: 'Street address.']
  city varchar [note: 'City.']
  state varchar [note: 'Two-letter US state code, uppercased.']
  zip_code varchar [note: 'ZIP or postal code.']

  Note: 'Conformed store dimension, Type 1. Includes a missing member row.'
}

Table dim_staff {
  dim_staff_sk varchar(32) [pk, note: 'Surrogate key. MD5 hash of staff_id.']
  staff_id integer [unique, not null, note: 'Natural key from sales.staffs. -1 for the missing member row.']
  first_name varchar [not null, note: 'Trimmed first name.']
  last_name varchar [not null, note: 'Trimmed last name.']
  full_name varchar [not null, note: 'Concatenated first and last name.']
  email varchar [note: 'Lowercased email address. Null for the missing member row.']
  phone varchar [note: 'Contact phone number.']
  is_active boolean [not null, note: 'True when the staff member is active.']
  store_id integer [not null, note: 'Store natural key assigned to this staff member.']
  manager_id integer [note: 'Direct manager natural key. Null for top-level staff.']
  manager_dim_staff_sk varchar(32) [not null, note: 'Surrogate key for the direct manager. Resolves to missing member when manager_id is null.']
  manager_full_name varchar [note: 'Flattened direct manager full name.']

  Note: 'Conformed staff dimension, Type 1. Includes one flattened manager hierarchy level.'
}

Table dim_date {
  dim_date_sk varchar(32) [pk, note: 'Surrogate key. MD5 hash of date_day cast to varchar.']
  date_day date [note: 'Calendar date. Null only for the missing member row.']
  year_number integer [note: 'Calendar year.']
  quarter_number integer [note: 'Calendar quarter number, 1 to 4.']
  quarter_label varchar [note: 'Quarter label, for example Q1.']
  month_number integer [note: 'Calendar month number, 1 to 12.']
  month_name varchar [note: 'Full month name.']
  week_of_year integer [note: 'ISO week number, 1 to 53.']
  day_of_month integer [note: 'Day of the month, 1 to 31.']
  day_of_week integer [note: 'DuckDB day of week, 0 is Sunday and 6 is Saturday.']
  day_name varchar [note: 'Full day name.']
  is_weekend boolean [note: 'True when day_of_week is Sunday or Saturday.']

  Note: 'Conformed date dimension generated from 2015-01-01 to 2034-12-31. Includes a missing member row.'
}

Table fct_sales {
  sales_pk varchar(32) [pk, note: 'Primary key. MD5 hash of order_id and item_id.']
  dim_date_sk varchar(32) [not null, note: 'FK to dim_date based on order_date.']
  dim_customer_sk varchar(32) [not null, note: 'FK to dim_customer. Guest or anonymous orders resolve to the missing member key.']
  dim_product_sk varchar(32) [not null, note: 'FK to dim_product.']
  dim_store_sk varchar(32) [not null, note: 'FK to dim_store.']
  dim_staff_sk varchar(32) [not null, note: 'FK to dim_staff.']
  order_id integer [not null, note: 'Degenerate dimension from sales.orders.']
  item_id integer [not null, note: 'Line-item sequence number within the order.']
  order_status integer [not null, note: 'Status code: 1=Pending, 2=Processing, 3=Rejected, 4=Completed.']
  order_status_label varchar [not null, note: 'Human-readable status label.']
  is_shipped boolean [not null, note: 'True when shipped_date is not null.']
  order_date date [not null, note: 'Date the order was placed.']
  required_date date [note: 'Requested delivery deadline.']
  shipped_date date [note: 'Actual shipment date. Null when not yet shipped.']
  quantity integer [not null, note: 'Units ordered on this line item.']
  list_price decimal(10,2) [not null, note: 'Unit price captured at order time.']
  discount decimal(4,2) [not null, note: 'Fractional discount applied to this line item.']
  line_total decimal(18,2) [not null, note: 'Revenue for this line: quantity * list_price * (1 - discount), rounded to 2 decimals.']

  Indexes {
    (order_id, item_id) [unique, name: 'uq_fct_sales_order_item']
  }

  Note: 'Atomic sales fact table at order line item grain. One row per order_id and item_id.'
}

Table fct_inventory {
  inventory_pk varchar(32) [pk, note: 'Primary key. MD5 hash of store_id and product_id.']
  dim_date_sk varchar(32) [not null, note: 'FK to dim_date based on snapshot_date.']
  dim_store_sk varchar(32) [not null, note: 'FK to dim_store.']
  dim_product_sk varchar(32) [not null, note: 'FK to dim_product.']
  store_id integer [not null, note: 'Degenerate dimension for store natural key.']
  product_id integer [not null, note: 'Degenerate dimension for product natural key.']
  snapshot_date date [not null, note: 'Date of the full-load ingestion run.']
  quantity integer [not null, note: 'Units on hand at this store for this product.']
  inventory_value decimal(18,2) [not null, note: 'Estimated inventory value: quantity * product list_price, rounded to 2 decimals.']

  Indexes {
    (store_id, product_id) [unique, name: 'uq_fct_inventory_store_product']
  }

  Note: 'Atomic inventory snapshot fact at store by product grain.'
}

TableGroup common_bs_star_schema {
  dim_date
  dim_customer
  dim_product
  dim_store
  dim_staff
  fct_sales
  fct_inventory
}

Ref: fct_sales.dim_date_sk > dim_date.dim_date_sk
Ref: fct_sales.dim_customer_sk > dim_customer.dim_customer_sk
Ref: fct_sales.dim_product_sk > dim_product.dim_product_sk
Ref: fct_sales.dim_store_sk > dim_store.dim_store_sk
Ref: fct_sales.dim_staff_sk > dim_staff.dim_staff_sk

Ref: fct_inventory.dim_date_sk > dim_date.dim_date_sk
Ref: fct_inventory.dim_store_sk > dim_store.dim_store_sk
Ref: fct_inventory.dim_product_sk > dim_product.dim_product_sk

Ref: dim_staff.manager_dim_staff_sk > dim_staff.dim_staff_sk
Ref: dim_staff.store_id > dim_store.store_id
